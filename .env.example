# Core runtime
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Persistence and sessions
DATABASE_URL=mysql://user:password@host:3306/kamvai
JWT_SECRET=replace-with-a-long-random-secret

# Managed authentication and AI gateway
OAUTH_SERVER_URL=https://your-oauth-server.example
VITE_APP_ID=replace-with-app-id
OWNER_OPEN_ID=replace-with-owner-open-id
BUILT_IN_FORGE_API_URL=https://your-managed-gateway.example
BUILT_IN_FORGE_API_KEY=replace-with-gateway-key

# Transactional email
SENDGRID_API_KEY=replace-with-sendgrid-key
SENDGRID_FROM_EMAIL=verified-sender@example.com
SENDGRID_OTP_TEMPLATE_ID=d-00000000000000000000000000000000

# Manual PayShap payment instructions
PAYSHAP_SHAP_ID=+27000000000@CAPITEC
PAYSHAP_RECIPIENT_NAME=Your business name
